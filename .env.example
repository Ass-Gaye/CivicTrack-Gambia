# CivicTrack Gambia — local development environment
# Copy this file to .env and adjust values. Never commit real credentials.

# --- Database (PostgreSQL) ---
# Local self-managed dev instance (see README "Starting the database").
# Production (Neon): provide the full Neon connection string with sslmode=require.
# Example: postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/civictrack?sslmode=require
DATABASE_URL="postgresql://civictrack@localhost:5433/civictrack_gambia?schema=public"

# --- API ---
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# Comma-separated list of origins allowed to call the API (with credentials).
# In production add your Vercel frontend URL, e.g.
# CORS_ORIGINS=https://civictrack-gambia.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# --- JWT authentication (officer sessions) ---
# Replace with a strong, random secret in production.
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# --- Demo officer account (seeded into the database) ---
DEMO_OFFICER_NAME="Duty Officer"
DEMO_OFFICER_EMAIL=officer@civictrack.gm
DEMO_OFFICER_PASSWORD=DemoOfficerPass123!

# --- Frontend (Vite) ---
# Prefixed with VITE_ so Vite exposes it to the client code.
# Leave unset (or empty) in production so the API client uses same-origin relative
# URLs (/api/...), which Vercel rewrites to the Render API via vercel.json.
# Set only if you want cross-origin calls to a specific API base.
VITE_API_URL=http://localhost:4000

# --- JWT authentication (officer sessions) ---
# Replace with a strong, random secret in production.
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# --- Demo officer account (seeded into the database) ---
DEMO_OFFICER_NAME="Duty Officer"
DEMO_OFFICER_EMAIL=officer@civictrack.gm
DEMO_OFFICER_PASSWORD=DemoOfficerPass123!

# --- Frontend (Vite) ---
# Prefixed with VITE_ so Vite exposes it to the client code.
VITE_API_URL=http://localhost:4000
