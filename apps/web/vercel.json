{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://civictrack-gambia-1.onrender.com/api/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
